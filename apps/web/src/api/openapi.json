            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "The signed-in member and their household.",
        "required": [
          "user",
          "household"
        ],
        "properties": {
          "household": {
            "$ref": "#/components/schemas/HouseholdDto"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "description": "What a client needs before signing in.",
        "required": [
