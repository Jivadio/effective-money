          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code (`not_found`, `invalid_email`, ...)."
          },
          "message": {
            "type": "string",
            "description": "Short English explanation, for logs and developers. Clients show a\ntranslated message chosen from `code`."
          }
        }
      },
      "GrantAccessRequest": {
        "type": "object",
        "required": [
          "permission"
        ],
        "properties": {
          "permission": {
            "$ref": "#/components/schemas/PermissionDto"
          }
        }
      },
      "HouseholdDto": {
        "type": "object",
        "required": [
          "id",
